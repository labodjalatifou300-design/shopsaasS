NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Browser-visible VAPID public key; never a secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=paste-the-generated-public-key-here

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PUSH_HOOK_SECRET=generate-a-long-random-secret
